{ schema }:

let
  inherit (schema)
    freeformSubmodule
    optional
    optionalNonEmptyString
    optionalString
    optionalStringList
    optionalSubmodule
    optionalSubmoduleWith
    required
    types
    ;
in
{
  name = optionalNonEmptyString "Human-readable browser name.";
  log_prefix = optionalNonEmptyString "Prefix used for log messages.";

  executable_name =
    required types.nonEmptyStr ''
      Name of the launcher generated by `tweezle apply`.
    ''
    // {
      example = "chromium";
    };

  alias_name = optionalNonEmptyString "Optional alias for the generated launcher.";
  flags_file = optionalString "Optional flags file read by the generated launcher.";
  flags = optionalStringList "Cross-platform Chromium command-line flags.";
  supports_manifest_v2 = schema.optionalBool "Whether this browser retains Manifest V2 support; otherwise check its runtime version.";
  user_agent = optionalNonEmptyString ''
    Custom browser user agent passed with Chromium's `--user-agent` switch.
  '';

  linux = optionalSubmodule {
    flatpak =
      optionalSubmoduleWith
        [
          (schema.optionsModule ../../../../nix/modules/settings/flatpak.nix { inherit schema; })
        ]
        ''
          Launch an installed Flatpak instead of a native browser bundle.
          Profile paths refer to host files under ~/.var/app/APP_ID.
        '';
    app_dir = optionalString "Default Linux browser bundle directory.";
    desktop_id = optionalNonEmptyString ''
      Desktop identifier used for the Wayland application ID and X11 startup
      WM class.
    '';
    portal_app_id = optionalNonEmptyString ''
      Compiled-in D-Bus application ID Chromium registers with XDG Desktop
      Portal.
    '';
    wrapper_flags = optionalStringList "Additional flags always passed by the Linux launcher.";
    launcher_name = optionalNonEmptyString "Launcher name inside the browser bundle.";
    desktop_name = optionalNonEmptyString "Desktop-entry path, absolute or relative to the browser bundle.";
    desktop_exec = optionalNonEmptyString "Executable name replaced in desktop entries.";
    icon_name = optionalNonEmptyString "Installed desktop icon name.";
    icon_source = optionalNonEmptyString "Icon path, absolute or relative to the browser bundle.";
  } "Linux-specific browser metadata.";

  macos = optionalSubmodule {
    app_dir = optionalString "Default macOS application bundle path.";
    launcher_path = optionalString "Launcher path relative to the application bundle.";
  } "macOS-specific browser metadata.";

  paths =
    required
      (types.attrsWith {
        elemType = freeformSubmodule {
          profile_dir = optionalString "Default Chromium profile directory.";
          policies_file = optionalString ''
            Managed policy destination for Flatpak installations. When omitted,
            use the installed package's Chromium Extension point.
          '';
          external_extension_dirs = optionalStringList ''
            Directories receiving external-extension manifests.
          '';
        };
        placeholder = "installation-mode";
      })
      ''
        Per-installation-mode paths. `''${home}`, `''${config_home}`, and
        `''${data_home}` are expanded at runtime.
      ''
    // {
      default = { };
      example.linux = {
        profile_dir = "\${config_home}/chromium/Default";
        external_extension_dirs = [ "\${config_home}/chromium/External Extensions" ];
      };
    };

  preferences =
    optionalSubmoduleWith [ (schema.optionsModule ./preferences.nix { inherit schema; }) ]
      ''
        Declarative browser preference mutations.
      '';

  extension_id_aliases = optional (types.attrsOf schema.extensionId) ''
    Mapping from configured extension IDs to the IDs of installed variants.
  '';
}
